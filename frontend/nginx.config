server {
    listen 80;
    server_name localhost;

    # lotes grandes: o padrão do nginx (1 MB) recusava o upload com 413. Mesmo limite da API (MAX_UPLOAD_MB).
    client_max_body_size 2048m;

    location /api/ {
        proxy_pass http://api:8000/;
        proxy_request_buffering off;   # repassa o arquivo à API enquanto chega, sem copiar para o disco do nginx
        proxy_read_timeout 300s;       # .zip e dossiê de lote grande demoram mais que os 60 s padrão
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        # Suporte ao React Router (Fallback para o index.html)
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}