server {
    listen 80;
    server_name localhost;

    # A API limita o arquivo a 2048 MiB por padrao.
    # Reserva 2 MiB para campos e cabecalhos multipart; acompanhe MAX_UPLOAD_MB da API.
    client_max_body_size 2050m;

    location /api/ {
        proxy_pass http://api:8000/;
        proxy_request_buffering off;   # repassa o arquivo enquanto chega
        proxy_read_timeout 300s;       # permite mais tempo para respostas demoradas
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        # Suporte ao React Router (Fallback para o index.html)
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
